const hex=(r,rot=Math.PI/6)=>{X.beginPath();for(let i=0;i<6;i++)X.lineTo(Math.cos(i*Math.PI/3+rot)*r,Math.sin(i*Math.PI/3+rot)*r);X.closePath()};
function mkPath(s){const r=rng(s*131+7),ml=2+s%3;let x=0,y=1+(r()*7|0),P=[[x,y]];
 while(x<GC-1){x=Math.min(GC-1,x+ml+(r()*3|0));P.push([x,y]);if(x>=GC-1)break;let n;do{n=1+(r()*7|0)}while(Math.abs(n-y)<2);y=n;P.push([x,y])}
 return P}
function prop(q,g,x,y,z,ac,r){q.save();q.translate(x,y);
 if(g==0){q.strokeStyle='#ffffff33';q.lineWidth=2;for(let i=-2;i<3;i++){q.beginPath();q.moveTo(i*3,0);q.lineTo(i*4,-z*.6);q.stroke()}if(r()<.4){q.fillStyle=ac;q.beginPath();q.arc(0,-z*.5,3,0,7);q.fill()}}
 else if(g==1){q.fillStyle='#00000055';for(let i=0;i<3;i++){q.beginPath();q.moveTo(-z*.6+i*2,-i*z*.5);q.lineTo(0,-z*(1+i*.5)-z*.5);q.lineTo(z*.6-i*2,-i*z*.5);q.fill()}}
 else if(g==2){q.strokeStyle='#0008';q.lineWidth=3;q.beginPath();q.moveTo(0,0);q.lineTo(0,-z*1.3);q.moveTo(0,-z*.7);q.lineTo(z*.6,-z*1.2);q.moveTo(0,-z*.9);q.lineTo(-z*.5,-z*1.4);q.stroke()}
 else if(g==3){q.strokeStyle='#ffffff30';q.lineWidth=3;q.beginPath();q.arc(0,0,z*2,Math.PI*1.1,Math.PI*1.9);q.stroke()}
 else if(g==4){q.fillStyle='#0004';q.fillRect(-z,-z*1.2,z*2,z*1.2);q.fillStyle='#ffffff18';q.fillRect(-z,-z*.8,z*2,3);q.fillRect(-z,-z*.4,z*2,3)}
 else if(g==5){q.fillStyle='#0007';q.beginPath();q.moveTo(-z*.4,0);q.lineTo(0,-z*1.6);q.lineTo(z*.4,0);q.fill();if(r()<.35){q.fillStyle=ac;q.shadowColor=ac;q.shadowBlur=12;q.beginPath();q.moveTo(0,-z);q.lineTo(5,-z*.5);q.lineTo(0,-z*.1);q.lineTo(-5,-z*.5);q.fill()}}
 else if(g==6){q.strokeStyle='#ffffff2a';q.lineWidth=2;q.beginPath();q.ellipse(0,0,z*1.3,z*.4,0,0,7);q.stroke();q.beginPath();q.arc(z,-z,3,0,7);q.stroke()}
 else if(g==7){q.fillStyle='#0009';q.fillRect(-z*.7,-z*2,z*1.4,z*2);q.fillStyle=ac;for(let i=0;i<6;i++)if(r()<.6)q.fillRect(-z*.5+(i%2)*z*.5,-z*1.8+(i>>1)*z*.55,4,5)}
 else if(g==8){q.fillStyle='#ffffff55';q.shadowColor='#8cf';q.shadowBlur=10;q.beginPath();q.moveTo(0,-z*1.5);q.lineTo(z*.4,-z*.4);q.lineTo(0,0);q.lineTo(-z*.4,-z*.4);q.fill()}
 else if(g==9){q.strokeStyle=ac;q.shadowColor=ac;q.shadowBlur=14;q.lineWidth=2;q.beginPath();q.moveTo(0,0);q.lineTo(z*.6,-z*.5);q.lineTo(z*.3,-z);q.lineTo(z,-z*1.4);q.stroke()}
 else{q.strokeStyle=ac+'88';q.shadowColor=ac;q.shadowBlur=12;q.lineWidth=1.5;q.beginPath();q.arc(0,0,z*.9,0,7);q.stroke();q.beginPath();for(let i=0;i<5;i++)q.lineTo(Math.cos(i*2.513-1.57)*z*.9,Math.sin(i*2.513-1.57)*z*.9);q.closePath();q.stroke()}
 q.restore()}
function mkBG(s){const [n,g,a,b,ac]=ST[s],cv=document.createElement('canvas');cv.width=W;cv.height=576;const q=cv.getContext('2d'),r=rng(s*77+5);
 let gr=q.createLinearGradient(0,0,0,576);gr.addColorStop(0,a);gr.addColorStop(1,b);q.fillStyle=gr;q.fillRect(0,0,W,576);
 for(let i=0;i<90;i++)prop(q,g,r()*W,40+r()*536,8+r()*24,ac,r);
 gr=q.createRadialGradient(W/2,288,200,W/2,288,640);gr.addColorStop(0,'#0000');gr.addColorStop(1,'#000b');q.fillStyle=gr;q.fillRect(0,0,W,576);return cv}
function loadStage(s){const P=mkPath(s),pts=P.map(p=>[p[0]*CE+32,p[1]*CE+32]),cum=[0],cells=new Set();
 for(let i=1;i<pts.length;i++)cum.push(cum[i-1]+Math.hypot(pts[i][0]-pts[i-1][0],pts[i][1]-pts[i-1][1]));
 for(let i=1;i<P.length;i++){const[a,b]=[P[i-1],P[i]];for(let k=0;k<=Math.max(Math.abs(b[0]-a[0]),Math.abs(b[1]-a[1]));k++)cells.add((a[0]+Math.sign(b[0]-a[0])*k)+','+(a[1]+Math.sign(b[1]-a[1])*k))}
 const tr=ST[s][7],N=6+Math.floor(s*.75);
 Object.assign(G,{scene:'play',s,pts,cum,L:cum[cum.length-1],cells,bg:mkBG(s),N,wave:1,lives:20,money:160+s*45,tw:[],en:[],bu:[],fx:[],q:[],tm:0,brk:120,paused:false,f:0,
  pa:Array.from({length:60},(_,i)=>({x:Math.random()*W,y:Math.random()*576,v:.3+Math.random()}))});startWave()}
function startWave(){const s=G.s,n=G.wave,tr=ST[s][7],boss=n%5==0||n==G.N;G.q=[];G.tm=0;
 if(boss){G.q.push({d:0,boss:1});for(let i=0;i<3+(s>>2);i++)G.q.push({d:80+i*45})}
 else{const c=Math.round((6+s*.4+n*1.4)*(tr.includes('s')?1.5:1));for(let i=0;i<c;i++)G.q.push({d:i*(tr.includes('s')?28:42)})}}
function spawn(o){const s=G.s,n=G.wave,[nm,g,a,b,ac,w,rr,tr,m]=ST[s];let hp=(28+n*8)*(1+s*.16),sp=(1+n*.02+s*.01)*(.9+Math.random()*.2);
 if(tr.includes('s'))hp*=.7;if(tr.includes('h'))hp*=1.4;if(tr.includes('z')){hp*=1.8;sp*=.6}if(tr.includes('f'))sp*=1.25;
 if(o.boss){hp*=10;sp*=.8}hp*=o.mini?.35:1;
 G.en.push({d:o.d0||0,hp,max:hp,sp,boss:o.boss,r:o.boss?26:o.mini?9:14,m,col:a==='#cfe6ff'?'#5a7aa8':b,acc:ac,w,rr,tr,x:G.pts[0][0],y:G.pts[0][1],dir:1,ph:Math.random()*6,k:4+s%5,alive:1,slowT:0,slowV:0,stunT:0,abT:0,dots:[],echo:0,mini:o.mini})}
function pos(d){const c=G.cum;for(let i=1;i<c.length;i++)if(d<=c[i]){const t=(d-c[i-1])/(c[i]-c[i-1]),a=G.pts[i-1],b=G.pts[i];return[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t]}return null}
function dmg(o,d,el,b){let m=1;if(o.w===el)m*=1.5;if(o.rr===el)m*=.5;if(o.tr.includes('a')&&el==='P')m*=.65;if(o.abT>0)m*=1.3;d*=m;o.hp-=d;o.echo+=d;
 if(b){const k=o.boss?.5:1;if(b.slow){o.slowT=Math.max(o.slowT,b.slow[1]*k);o.slowV=Math.max(o.slowV,b.slow[0]*(o.tr.includes('t')?.5:1))}
  if(b.stun)o.stunT=Math.max(o.stunT,b.stun*k);if(b.ab)o.abT=b.ab;
  if(b.dot){const x=o.dots.filter(z=>z.el==b.dot.el);if(x.length>=3)o.dots.splice(o.dots.indexOf(x[0]),1);o.dots.push({d:b.dot.d,t:b.dot.t,el:b.dot.el})}}
 if(o.hp<=0&&o.alive){o.alive=0;G.money+=o.boss?120+G.s*8:Math.round((7+G.s*.6)*(o.mini?.3:1));for(let i=0;i<8;i++)G.fx.push({x:o.x,y:o.y,vx:Math.random()*4-2,vy:Math.random()*4-2,l:30,c:o.acc});
  if(o.tr.includes('p')&&!o.mini)for(let i=0;i<2;i++)spawn({mini:1,d0:Math.max(0,o.d-i*14)})}}
function tbuff(t){let m=1;for(const u of G.tw)if(u.sp.includes('buff')&&Math.hypot(u.x-t.x,u.y-t.y)<=u.range)m+=.25*(1+.15*(u.lv-1));return Math.min(m,1.75)}
function fire(t,e){const s=t.sp,o={x:t.x,y:t.y,t:e,dmg:t.dmg*tbuff(t),el:t.el,aoe:+((s.match(/aoe(\d+)/)||[])[1]||0),c:t.c,sp:7};
 if(s.includes('snipe')&&e.boss)o.dmg*=1.5;
 if(s.includes('slow'))o.slow=[.35,90];if(s.includes('grav'))o.slow=[.5,60];if(s.includes('time'))o.slow=[.4,100];
 if(s.includes('stun'))o.stun=40;if(s.includes('armor'))o.ab=120;
 if(s.includes('poison'))o.dot={d:2*(1+.2*(t.lv-1)),t:120,el:'T'};if(s.includes('burn'))o.dot={d:1.2*(1+.2*(t.lv-1)),t:90,el:'F'};
 if(s.includes('chain'))o.chain=3;
 if(s.includes('echo')&&e.echo>0){o.dmg=Math.min(e.echo*.35,t.dmg*8);e.echo=0}
 G.bu.push(o)}
function hit(b){const e=b.t;if(!e.alive)return;if(e.tr.includes('d')&&Math.random()<.2){G.fx.push({x:e.x,y:e.y,vx:0,vy:-1,l:20,c:'#fff'});return}
 if(b.aoe){for(const o of G.en)if(o.alive&&Math.hypot(o.x-e.x,o.y-e.y)<=b.aoe)dmg(o,b.dmg,b.el,b)}else dmg(e,b.dmg,b.el,b);
 if(b.chain){const n=G.en.filter(o=>o.alive&&o!==e&&Math.hypot(o.x-e.x,o.y-e.y)<=110).slice(0,b.chain);for(const o of n)dmg(o,b.dmg*.7,b.el,null)}
 for(let i=0;i<4;i++)G.fx.push({x:b.x,y:b.y,vx:Math.random()*3-1.5,vy:Math.random()*3-1.5,l:14,c:b.c})}
function upd(){if(G.scene!='play'||G.paused)return;G.f++;
 while(G.q.length&&G.q[0].d<=G.tm)spawn(G.q.shift());G.tm++;
 if(!G.q.length&&!G.en.some(e=>e.alive)){if(G.brk-->0)return;G.brk=120;
  if(G.wave>=G.N){G.scene='win';if(G.s+1>G.unl){G.unl=G.s+1;try{localStorage.setItem('ntd_unl',G.unl)}catch(e){}}return}
  G.wave++;G.money+=30+G.s*3;startWave()}
 for(const e of G.en){if(!e.alive)continue;
  if(G.f%20==0&&e.dots.length){let s=0;for(const z of e.dots)s+=z.d*(e.tr.includes('o')?.5:1);dmg(e,s,e.dots[0].el,null)}
  e.dots=e.dots.filter(z=>--z.t>0);if(e.tr.includes('r'))e.hp=Math.min(e.max,e.hp+e.max*.0003);
  e.slowT--;e.stunT--;e.abT--;if(e.slowT<=0)e.slowV=0;let sp=e.stunT>0?0:e.sp*(1-e.slowV);e.d+=sp;
  const p=pos(e.d);if(!p){e.alive=0;G.lives--;if(G.lives<=0)G.scene='over';continue}if(p[0]<e.x-.1)e.dir=-1;else if(p[0]>e.x+.1)e.dir=1;[e.x,e.y]=p}
 G.en=G.en.filter(e=>e.alive);
 for(const t of G.tw){t.a2=t.a2||0;if(t.sp.includes('buff'))continue;t.cd--;let b=null;for(const e of G.en)if(Math.hypot(e.x-t.x,e.y-t.y)<=t.range&&(!b||e.d>b.d))b=e;
  if(b){t.a=Math.atan2(b.y-t.y,b.x-t.x);if(t.cd<=0){t.cd=t.rate;t.fl=6;fire(t,b)}}if(t.fl>0)t.fl--}
 for(const b of G.bu){const e=b.t;if(!e.alive){b.dead=1;continue}const dx=e.x-b.x,dy=e.y-b.y,d=Math.hypot(dx,dy);if(d<=b.sp+4){hit(b);b.dead=1}else{b.x+=dx/d*b.sp;b.y+=dy/d*b.sp}}
 G.bu=G.bu.filter(b=>!b.dead);for(const f of G.fx){f.x+=f.vx;f.y+=f.vy;f.l--}G.fx=G.fx.filter(f=>f.l>0);
 for(const p of G.pa){p.y+=(ST[G.s][1]==8?p.v:-p.v);p.x+=Math.sin(p.y/40)*.3;if(p.y>576)p.y=0;if(p.y<0)p.y=576}}
function drawMon(e,t){const r=e.r,m=e.m,a=e.acc;X.save();X.translate(e.x,e.y+Math.sin(t*4+e.ph)*1.5);
 X.fillStyle='#0006';X.beginPath();X.ellipse(0,r*.9,r*.9,r*.3,0,0,7);X.fill();
 if(e.boss){X.save();X.rotate(t*.6);X.strokeStyle=a;X.lineWidth=2;X.setLineDash([8,6]);X.beginPath();X.arc(0,0,r*1.45,0,7);X.stroke();X.restore();
